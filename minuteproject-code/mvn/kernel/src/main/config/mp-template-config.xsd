<xs:schema id="target" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns="http://minuteproject.sf.net/xsd/mp-template-config"
	targetNamespace="http://minuteproject.sf.net/xsd/mp-template-config"
	elementFormDefault="qualified">

	<xs:element name="target" type="target">
	</xs:element>

	<xs:complexType name="target">
		<xs:sequence>
			<xs:element name="architecture-target" type="architecture-target"
				minOccurs="0" maxOccurs="unbounded">
			</xs:element>
			<xs:element name="plugin" type="plugin" minOccurs="0"
				maxOccurs="unbounded">
			</xs:element>
			<xs:element name="template-target" type="template-target"
				minOccurs="0" maxOccurs="unbounded">
			</xs:element>
		</xs:sequence>
		<xs:attribute name="name" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="architecture-target">
		<xs:attribute name="name" type="xs:string" />
		<xs:attribute name="description" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="plugin">
		<xs:attribute name="name" type="xs:string" />
		<xs:attribute name="className" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="property">
		<xs:attribute name="name" type="xs:string" />
		<xs:attribute name="value" type="xs:string" />
		<xs:attribute name="tag" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="template">
		<xs:sequence>
			<xs:element name="property" type="property" minOccurs="0"
				maxOccurs="unbounded">
			</xs:element>
		</xs:sequence>
		<xs:attribute name="name" type="xs:string" />
		<xs:attribute name="templateFileName" type="xs:string" />
		<xs:attribute name="subdir" type="xs:string" />
		<xs:attribute name="outputsubdir" type="xs:string" />
		<xs:attribute name="technicalPackage" type="xs:string" />
		<xs:attribute name="add-model-name" type="xs:boolean" />
		<xs:attribute name="add-model-dir-name" type="xs:boolean" />
		<xs:attribute name="add-package-name" type="xs:boolean" />
		<xs:attribute name="is-indirection-compatible" type="xs:boolean" />
		<xs:attribute name="file-extension" type="xs:string" />
		<xs:attribute name="file-prefix" type="xs:string" />
		<xs:attribute name="file-suffix" type="xs:string" />
		<xs:attribute name="entity-specific" type="xs:string" />
		<xs:attribute name="package-specific" type="xs:string" />
		<xs:attribute name="model-specific" type="xs:string" />
		<xs:attribute name="check-template-to-generate" type="xs:string" />
		<xs:attribute name="is-template-to-generate-method" type="xs:string" />
		<xs:attribute name="field-specific" type="xs:string" />
		<xs:attribute name="file-name-builder-plugin" type="xs:string" />
		<xs:attribute name="file-name-builder-method" type="xs:string" />
		<xs:attribute name="application-specific" type="xs:string" />
		<xs:attribute name="model-type" type="model-type" />
		<xs:attribute name="package-root" type="xs:string" />
		<xs:attribute name="add-technical-dir-name" type="xs:boolean" />
		<xs:attribute name="scope-specific-value" type="scope-specific-value-type" /><!-- todo enum-->
		<xs:attribute name="add-business-package-dir-name" type="xs:boolean" />
		<xs:attribute name="has-updatable-nature" type="xs:boolean" />
	</xs:complexType>

     <xs:simpleType name="scope-specific-value-type">
         <xs:restriction base="xs:string">
             <xs:enumeration value="application" >
				 <xs:annotation>
					 <xs:documentation>
						 application: just one, generation at root level
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
             <xs:enumeration value="application-package" >
				 <xs:annotation>
					 <xs:documentation>
						 application-package: just one, generation at main package level
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
             <xs:enumeration value="model" >
				 <xs:annotation>
					 <xs:documentation>
						 model: one for each model, generation at model package level
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
             <xs:enumeration value="entity" >
				 <xs:annotation>
					 <xs:documentation>
						entity: one for each entity, generation at model package + technical package + entity
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
             <xs:enumeration value="function" />
			 <xs:enumeration value="composite" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each composite (target multiple queries), generation at model package + technical package + composite
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="query" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each query, generation at model package + technical package + query
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="sdd-input-bean" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each query input, generation at model package + technical package + query input
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="sdd-output-bean" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each query output, generation at model package + technical package + query output
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="sdd-input-composite-bean" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each composite input, generation at model package + technical package + composite input
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="sdd-output-composite-bean" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each composite output, generation at model package + technical package + composite output
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="function-input-entity" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each function input, generation at model package + technical package + function input
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="function-output-entity" >
				 <xs:annotation>
					 <xs:documentation>
						 entity: one for each function output, generation at model package + technical package + function output
					 </xs:documentation>
				 </xs:annotation>
			 </xs:enumeration>
			 <xs:enumeration value="foreignkey" />
			 <xs:enumeration value="transfer-entity" />
			 <xs:enumeration value="action" />
			 <xs:enumeration value="query-package" />
			 <xs:enumeration value="query-pivot" />
         </xs:restriction>
     </xs:simpleType>

     <xs:simpleType name="model-type">
         <xs:restriction base="xs:string">
             <xs:enumeration value="any" />
             <xs:enumeration value="rdbms" />
             <xs:enumeration value="mongodb" />
         </xs:restriction>
     </xs:simpleType>
     
	<xs:complexType name="template-target">
		<xs:sequence>
			<xs:element name="template" type="template" minOccurs="0"
				maxOccurs="unbounded">
			</xs:element>
			<xs:element name="property" type="property" minOccurs="0"
				maxOccurs="unbounded">
			</xs:element>
		</xs:sequence>
		<xs:attribute name="name" type="xs:string" />
		<xs:attribute name="libdir" type="xs:string" />
		<xs:attribute name="tool" type="xs:string" />
		<xs:attribute name="outputdir" type="xs:string" />
		<xs:attribute name="package-root" type="xs:string" />
		<xs:attribute name="belongToPackage" type="xs:string" />
		<xs:attribute name="templatedir" type="xs:string" />
	</xs:complexType>

</xs:schema>
