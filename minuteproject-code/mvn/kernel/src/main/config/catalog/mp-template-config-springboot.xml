<target name="springboot"
xmlns="http://minuteproject.sf.net/xsd/mp-template-config" 
xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" 
xs:schemaLocation="./mp-template-config.xsd">	
	<architecture-target name="springboot REST GRAPHQL API" description="springboot REST GRAPHQL API"/>

	<template-target
			name="Spring boot core resources"
			outputdir="src/main/resources"
			belongToPackage="true">

		<template name="SpringBoot.app-info.properties" templateFileName="SpringBoot.app-info.properties.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="properties" file-prefix="" file-suffix="app-info"
				  scope-specific-value="application" add-model-name="false" add-package-name="false">
		</template>

		<template name="SpringBootApplication.prop" templateFileName="SpringBootApplication.prop.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="properties" file-prefix="" file-suffix="application"
				  scope-specific-value="application" add-model-name="false" add-package-name="false">
		</template>

		<template name="SpringBoot.logback" templateFileName="SpringBoot.logback.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="xml" file-prefix="" file-suffix="-logback"
				  scope-specific-value="application" add-model-name="true"
				  add-package-name="false" add-technical-dir-name="false"
		>
			<!-- use at config level <property name="logback-use-DB-appender" value="true"/>
			-->
		</template>

		<template name="SpringBoot.logback.local" templateFileName="SpringBoot.logback.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="xml" file-prefix="" file-suffix="-logback-local"
				  scope-specific-value="application" add-model-name="true"
				  add-package-name="false" add-technical-dir-name="false"
		>
			<property name="logback-use-DB-appender" value="false"/>
		</template>

		<template name="SpringBoot.banner.txt" templateFileName="SpringBoot.banner.txt.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="txt" file-prefix="" file-suffix="banner"
				  scope-specific-value="application" add-model-name="false"
				  add-package-name="false" add-technical-dir-name="false"
		/>

		<!-- caching -->
		<template name="EhCacheXml" templateFileName="EhCache.Xml.vm"
				  subdir="" outputsubdir="" technicalPackage="" has-updatable-nature="true"
				  file-extension="xml" file-prefix="ehcache" file-suffix=""
				  application-specific="true" package-root=""
				  add-model-name="false"
				  check-template-to-generate="true" is-template-to-generate-method="enrichmentUtils.isToGenerateBasedOnPropertyPresence">
			<property name="property-presence" value="add-cache-implementation" ></property>
		</template>

	</template-target>

	<template-target
			name="Spring boot core resources local"
			outputdir="src/main/resources-local"
			belongToPackage="true">
		<template name="SpringBootApplication.jdbc-params.prop" templateFileName="SpringBootApplication.jdbc.prop.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="properties" file-prefix="" file-suffix="application-jdbc-params"
				  scope-specific-value="application" add-model-name="false" add-package-name="false">
			<property name="embedded-datasource" value="false"/>
		</template>

		<!-- TODO add gitignore -->
	</template-target>


	<template-target
			name="Spring boot core resources remote"
			outputdir="src/main/resources-remote"
			belongToPackage="true">

		<template name="SpringBootApplication.jdbc-cp.prop" templateFileName="SpringBootApplication.jdbc.prop.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="properties" file-prefix="" file-suffix="application-jdbc-cp"
				  scope-specific-value="application" add-model-name="false" add-package-name="false">
			<property name="embedded-datasource" value="true"/>
		</template>

	</template-target>

	<template-target
			name="Spring boot core files"
			outputdir="src/main/java"
			belongToPackage="true">

		<template name="SpringBootApplication" templateFileName="SpringBootApplication.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="java" file-prefix="" file-suffix="Application"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBootServletInitializer" templateFileName="SpringBootServletInitializer.vm"
				  subdir="" outputsubdir="" technicalPackage=""
				  file-extension="java" file-prefix="" file-suffix="ServletInitializer"
				  scope-specific-value="model" add-model-name="false">
		</template>


		<template name="SpringBoot.app-info.controller" templateFileName="SpringBoot.app-info.controller.vm"
				  subdir="" outputsubdir="" technicalPackage="controller"
				  file-extension="java" file-prefix="" file-suffix="AppInfoController"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBootWebFilterConfig" templateFileName="SpringBootWebFilterConfig.vm"
				  subdir="" outputsubdir="" technicalPackage="web"
				  file-extension="java" file-prefix="" file-suffix="WebFilterConfig"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBoot.cache.config" templateFileName="SpringBoot.cache.config.vm"
				  subdir="" outputsubdir="" technicalPackage="config"
				  file-extension="java" file-prefix="" file-suffix="CacheConfig"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBoot.annotation.AuditLogging" templateFileName="SpringBoot.annotation.AuditLogging.vm"
				  subdir="" outputsubdir="" technicalPackage="annotation"
				  file-extension="java" file-prefix="" file-suffix="AuditLogger"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBoot.aop.AuditLoggingAspect" templateFileName="SpringBoot.aop.AuditLoggingAspect.vm"
				  subdir="" outputsubdir="" technicalPackage="aop"
				  file-extension="java" file-prefix="" file-suffix="AuditLoggingAspect"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<template name="SpringBootWebSecurityConfig" templateFileName="SpringBootWebSecurityConfig.vm"
				  subdir="" outputsubdir="" technicalPackage="web"
				  file-extension="java" file-prefix="" file-suffix="WebSecurityConfig"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<!-- commons -->
		<template name="SpringBoot.rest.preconditions" templateFileName="SpringBoot.rest.preconditions.vm"
				  subdir="" outputsubdir="" technicalPackage="controller"
				  file-extension="java" file-prefix="" file-suffix="RestPreconditions"
				  scope-specific-value="model" add-model-name="false">
		</template>

		<!-- query -->
		<template name="SpringBoot.sdd.controller" templateFileName="SpringBoot.SDD.controller.vm"
				  subdir="" outputsubdir="" technicalPackage="controller"
				  file-extension="java" file-prefix="" file-suffix="Controller"
				  add-package-name="false" add-business-package-dir-name="false"
				  scope-specific-value="query"
				  check-template-to-generate="true" is-template-to-generate-method="queryUtils.isToGenerateBasedRestStackRequired"
				  is-indirection-compatible="true"
		>
			<!-- is-indirection-compatible="true" -->
			<property name="JavaBeanTemplate" value="SDDOutputBean" />
		</template>

		<template name="SpringJdbcTemplate.sdd.repository" templateFileName="SpringJdbcTemplate.sdd.repository.vm"
				  subdir="" outputsubdir="" technicalPackage="repository"
				  file-extension="java" file-prefix="" file-suffix="JdbcTemplate"
				  add-package-name="false" add-business-package-dir-name="false"
				  scope-specific-value="query"
				  is-indirection-compatible="true"
		>
			<!-- is-indirection-compatible="true" -->
			<property name="JavaBeanTemplate" value="SDDOutputBean" />
		</template>

	</template-target>

	<template-target
			name="Springboot Maven"
			outputdir=""
			package-root=""
			libdir="lib/REST_LIB.vm">

		<template name="SpringBoot.PomXml" templateFileName="SpringBoot.PomXml.vm"
				  subdir="" outputsubdir="" technicalPackage="" has-updatable-nature="true"
				  file-extension="xml" file-prefix="pom" file-suffix=""
				  application-specific="true" add-model-name="false">
		</template>

	</template-target>

	<!--
	<template-target
			name="REST java  set"
			libdir="lib/SPRING_LIB.vm"
			outputdir="src/main/java"
			belongToPackage="true">

		<template name="SpringBoot.SDD.Controller" templateFileName="SpringBoot.SDD.Controller.vm"
				  file-extension="java" technicalPackage="controller" file-suffix="Controller"
				  scope-specific-value="query" has-updatable-nature="true" >
			<property name="add-message-format" value="message-format"></property>
		</template>

	</template-target>
	-->
</target>
