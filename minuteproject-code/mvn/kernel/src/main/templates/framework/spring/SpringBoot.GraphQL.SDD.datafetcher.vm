#exposeSpringBootQuerySpecific()
#putImportQuerySDDBeanV2()
package $packageName;

import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;

#if($isNotVoidInput)
import $sddInputBeanImport;
#end
import $springBootJdbcTemplateRepositoryImport;
import $sddOutputBeanImport;
import graphql.schema.DataFetcher;
import graphql.schema.DataFetchingEnvironment;
import org.springframework.stereotype.Component;

import java.util.List;
import java.util.stream.Collectors;

@Component
@Slf4j
@AllArgsConstructor
public class ${className} implements DataFetcher<List<$sddOutputBeanClass>> {

    private ${springBootJdbcTemplateRepositoryClass} $springBootJdbcTemplateRepositoryVariable;

    @Override
    public List<$sddOutputBeanClass> get(DataFetchingEnvironment dataFetchingEnvironment) {
#foreach($queryChunk in $query.getQueryChunks())
    #set($chunkName=$javaUtils.getJavaVariableNaming($queryChunk.name))
    String $chunkName = dataFetchingEnvironment.getArgument("${chunkName}");
#end
#if($isNotVoidInput)
        $sddInputBeanClass $sddInputBeanVariable = new $sddInputBeanClass ();
#foreach($column in $inputBean.columns)
#putColumnParamNaming()
#if (!$column.hasBeenDuplicated())
#if (!$column.isImplicit())
#if ($columnUtils.isDate($column))
        java.time.OffsetDateTime ${columnVar}OffsetDateTime = dataFetchingEnvironment.getArgument("${columnVar}");
        if (${columnVar}OffsetDateTime!=null) {
            java.util.Date ${columnVar}Date = java.util.Date.from(${columnVar}OffsetDateTime.toInstant());
            ${sddInputBeanVariable}.set$columnClass (${columnVar}Date);
        }
#else
#set($isArray=$column.isArray())
#set($targetQuery=$columnUtils.getLinkedQueryMasterdataEnum($model, $column))
#if ($columnUtils.isLink($column) && $targetQuery)
#exposeSDDMasterDataEnum($targetQuery)
#if(!$isArray)
        String ${columnVar}Arg = dataFetchingEnvironment.getArgument("${columnVar}");
        if (${columnVar}Arg!=null) {
            ${masterDataEnumImport} ${columnVar} = ${masterDataEnumImport}.valueOf(${columnVar}Arg);
            if (${columnVar}!=null) {
                ${sddInputBeanVariable}.set$columnClass (${columnVar});
            }
        }
#else
        List<String> ${columnVar}Arg = dataFetchingEnvironment.getArgument("${columnVar}");
        if (${columnVar}Arg!=null) {
            List<${masterDataEnumImport}> ${columnVar}List = ${columnVar}Arg.stream()
                .map(${masterDataEnumImport}::valueOf)
                .collect(Collectors.toList());
            if (${columnVar}List!=null && !${columnVar}List.isEmpty()) {
                ${sddInputBeanVariable}.set$columnClass (${columnVar}List);
            }
        }
#end
#else
        ${sddInputBeanVariable}.set$columnClass (dataFetchingEnvironment.getArgument("${columnVar}"));
#end
#end
#elseif ($column.isImplicit()) ##TODO check if sessionParam
#if ($column.useJwtSubject())
//Jwtsubject TODO
#elseif ($column.defaultValue)
        ${columnType} ${columnClass}_DEFAULT = "$column.defaultValue"; ##TODO with other column type
        ${sddInputBeanVariable}.set$columnClass (dataFetchingEnvironment.getArgument(${columnClass}_VALUE));
#end
#end
#end
#end
#end
        return ${springBootJdbcTemplateRepositoryVariable}.execute (
#daoParameters()
            );
    }

}
