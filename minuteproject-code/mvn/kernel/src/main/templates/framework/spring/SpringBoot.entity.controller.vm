@RequestMapping ("/entity/${tableVariableName}")
@Controller
@Slf4j
@AllArgsConstructor
@Tag(name = "${className} API", description = "${className} API")
public class ${className} {

	${entityRepositoryClass} $entityRepositoryVariable;

	@RequestMapping(value = "/{$primaryKeyVariable}", method = RequestMethod.GET)
	@ResponseBody
    public ResponseEntity<$tableClassName> findById (@PathVariable ("$primaryKeyVariable") $primaryKeyFullType $primaryKeyVariable) {
		$tableClassName entity = ${entityRepositoryVariable}.findById($primaryKeyVariable)
			.orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND));
		return ResponseEntity.ok(entity);
    }
