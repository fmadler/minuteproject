#if ($tableUtils.isLiveBusinessDataContentType($table))
	public ResponseEntity<Page<$tableClassName>> findAllBy (
#foreach($column in $tableUtils.getSearchableColumns($table))
#putColumnParamNaming()
		#if($velocityCount>1),#end @RequestParam(value="$columnVar", required = false) $columnType $columnVar
#end
		#if($tableUtils.getSearchableColumns($table).size()>0) , #end @RequestParam(defaultValue = "0") int _page
		,@RequestParam(defaultValue = "10") int _size
	) {
#springdataspecification()
#set($ordering=$orderingUtils.getFirstOrdering($table))
#set($column=$ordering.column)
#set($order=$formatUtils.lowerCase(${ordering.order.toString()}))
#putColumnParamNaming()
	//ordering $columnVar
		Sort sort = Sort.by(Sort.Direction.ASC, "$columnVar");
		Pageable pageable = PageRequest.of(_page, _size, sort);
		Page<$tableClassName> page = ${entityRepositoryVariable}.findAll(spec, pageable);
		return ResponseEntity.ok(page);
	}
#else
	public ResponseEntity<List<$tableClassName>> findAllBy (
#foreach($column in $tableUtils.getSearchableColumns($table))
#putColumnParamNaming()
		#if($velocityCount>1),#end @RequestParam(value="$columnVar", required = false) $columnType $columnVar
#end
	) {
#springdataspecification()
		List<$tableClassName> list = ${entityRepositoryVariable}.findAll(spec);
		return ResponseEntity.ok(list);
	}
