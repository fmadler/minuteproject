[tools]
java = "temurin-8"
maven = "latest"

[env]
# Environment variables for Maven
MAVEN_OPTS = "-Xmx1024m -Xms512m"

# Aliases for common Maven commands
[tasks.mvn-clean]
run = "mvn clean"

[tasks.mvn-install]
run = "mvn install"

[tasks.mvn-test]
run = "mvn test"

[tasks.mvn-package]
run = "mvn package"

[tasks.clean-package]
run = "mvn clean package"

[tasks.mvn-deploy]
run = "mvn deploy"

[tasks.springboot-run-local]
run = "mvn clean package spring-boot:run -Dspring-boot.run.profiles=jdbc-params -Plocal"

[tasks.springboot-build-embedded-cp]
run = "mvn clean package -DactiveProfiles=jdbc-params -Plocal"

[tasks.springboot-build-server-cp]
run = "mvn clean package -DactiveProfiles=jdbc-cp -Premote"
